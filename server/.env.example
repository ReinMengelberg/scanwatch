# camserver settings. Copy to .env and fill in. Real env vars override this file.

# --- Camera + web -------------------------------------------------------------
CAM_DEV=/dev/video0
BIND=127.0.0.1                # localhost only: open the UI through ./deploy.sh --ui (SSH tunnel)
PORT=8080
SIZE=1280x720                 # capture mode (v4l2-ctl --list-formats-ext)
CAM_FPS=15
FPS=10                        # processing/view rate
VIEW_WIDTH=960                # 960x540 = the frame size the models are trained on; keep in sync
VIEW_QUALITY=7
STATE_FILE=~/.camserver.json

# --- Motion gate (only wakes the detector) -----------------------------------
MOTION_SIZE=160x90
MOTION_DIFF=25
MOTION_MIN=0.005              # changed fraction of the ROI
MOTION_MAX=0.6
MOTION_HOLD=3                 # seconds to keep detecting after the last motion
BG_RATE=0.1
# Road polygon, normalised x,y pairs. Motion and tracks only count inside it.
# Check it on http://localhost:<PORT>/debug.jpg (./deploy.sh --ui) after changing the camera framing.
ROI=0,0.676;0.448,0.593;1,0.47;1,0.741;0,0.852

# --- Detection + tracking ----------------------------------------------------
DET_MODEL=models/yolo11n_416_ncnn_model   # relative to server/
DET_IMGSZ=416
DET_CONF=0.25
MIN_BOX=40                    # px; must match training (train/scancar/crop.py MIN_BOX)
# Extra low-confidence pass before a full frame is stored, so every plate/person gets blurred
BLUR_MODEL=models/yolo11n_640_ncnn_model
BLUR_IMGSZ=640
BLUR_CONF=0.05
TRACK_IOU=0.2
TRACK_LOST=1.5                # seconds unseen before a track ends
MIN_TRAVEL=0.15               # fraction of frame width a track must move (parked cars don't)
CROPS_PER_TRACK=3

# --- Scan-car classifier (leave CLS_MODEL empty until a model is trained) ----
CLS_MODEL=
CLS_IMGSZ=224
CLS_THRESHOLD=                # alert threshold; empty = threshold.json next to the model
ROUTE_THRESHOLD=0.3           # >= this goes to scancar/ on S3, else car/ (prefer false positives)

# --- Discord alerts (when P(scancar) >= the alert threshold) ------------------
DISCORD_WEBHOOK_URL=          # channel settings > Integrations > Webhooks > Copy URL. Secret!
DISCORD_MIN_GAP=60            # seconds between alerts

# --- Empty-street frames ------------------------------------------------------
EMPTY_EVERY=3600
EMPTY_QUIET=60

# --- Spool + S3 ---------------------------------------------------------------
SPOOL_DIR=~/scanwatch/spool
MIN_FREE_GB=2
UPLOAD=1                      # 0 = spool locally only
ANNOTATE=1                    # also upload annotated.jpg: frame + boxes + path, for checking
S3_ENDPOINT=https://fsn1.your-objectstorage.com   # Hetzner Object Storage
S3_BUCKET=scanwatch
S3_REGION=us-east-1
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
