# camserver settings. Copy to .env and fill in. Real env vars override this file.

# --- Camera + web -------------------------------------------------------------
CAM_DEV=/dev/video0
BIND=127.0.0.1                # localhost only: open the UI through an SSH tunnel (see README)
PORT=8080
SIZE=1280x720                 # capture mode (v4l2-ctl --list-formats-ext)
CAM_FPS=15
FPS=10                        # processing/view rate
VIEW_WIDTH=960                # 960x540 = the frame size the models are trained on; keep in sync
VIEW_QUALITY=7
STATE_FILE=~/.camserver.json

# --- Motion gate (only wakes the detector) -----------------------------------
MOTION_SIZE=160x90
MOTION_DIFF=25
MOTION_MIN=0.005              # changed fraction of the ROI
MOTION_MAX=0.6
MOTION_HOLD=3                 # seconds to keep detecting after the last motion
BG_RATE=0.1
# Road polygon, normalised x,y pairs. Motion and tracks only count inside it.
# Check it on http://localhost:<PORT>/debug.jpg (through the SSH tunnel) after changing the camera framing.
ROI=0,0.73;0.45,0.58;1,0.44;1,0.69;0.45,0.84;0,0.95

# --- Detection + tracking ----------------------------------------------------
DET_MODEL=models/yolo11n_416_ncnn_model   # relative to server/
DET_IMGSZ=416
DET_CONF=0.25
MIN_BOX=40                    # px; must match training (train/scancar/crop.py MIN_BOX)
TRACK_IOU=0.2
PARKED_AFTER=2                # seconds without moving = parked/waiting car ...
PARKED_IOU=0.5                # ... which only continues on a box overlapping it this much
TRACK_LOST=1.5                # seconds unseen before a track ends
MIN_TRAVEL=0.1                # fraction of frame width a track must move (parked cars don't)
CROPS_PER_TRACK=3

# --- Scan-car classifier (empty CLS_MODEL = only collect, no alerts) ----------
CLS_MODEL=models/scancar_cls_ncnn_model  # shipped in git, installed by setup-server.sh
CLS_IMGSZ=224
CLS_THRESHOLD=                # alert threshold; empty = threshold.json in the model dir (recall-first, see train.py)
ROUTE_THRESHOLD=0.15          # >= this goes to scancar/ on S3, else car/ (prefer false positives)

# --- Discord alerts (when P(scancar) >= the alert threshold) ------------------
DISCORD_WEBHOOK_URL=          # channel settings > Integrations > Webhooks > Copy URL. Secret!
DISCORD_MIN_GAP=60            # seconds between alerts

# --- Empty-street frames ------------------------------------------------------
EMPTY_EVERY=3600
EMPTY_QUIET=60

# --- Spool + S3 ---------------------------------------------------------------
SPOOL_DIR=~/scanwatch/spool
MIN_FREE_GB=2
UPLOAD=1                      # 0 = spool locally only
LOG_IGNORED=1                 # upload ignored/<date>/<track>.json: dropped tracks and why
ANNOTATE=1                    # also upload annotated.jpg: frame + boxes + path, for checking
S3_ENDPOINT=https://fsn1.your-objectstorage.com   # Hetzner Object Storage
S3_BUCKET=scanwatch
S3_REGION=us-east-1
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
